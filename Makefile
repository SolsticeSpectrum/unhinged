# Trith (docs/TRITH.md). The compiler exists twice: s1, trith/src (build/trithc), is
# written in UNHINGED, the language Trith replaced; s2, trith/s2 (build/s2c), is written
# in Trith and compiled by s1. UNHINGED survives only to bootstrap s1: a Rust compiler
# (unhinged/bootstrap) builds the self-hosted UNHINGED compiler (unhinged/compiler).
UNHINGEDC_BOOT := build/bootstrap
UNHINGEDC_STAGE1 := build/stage1
UNHINGEDC := build/unhingedc
UNHINGED_TESTS := build/unhinged-tests
TRITHC := build/trithc
TRITH_TESTS := build/trith-tests
.PHONY: all unhinged unhinged-test test clean trith trith-test trith-bench trith-memcheck s2 s2-regen s2-test s2-golden s2-fuzz s3 s2-fixpoint lib-test lib-regen bench-regen

all: s2

test: trith-test s2-test s2-golden s2-fixpoint lib-test unhinged-test

# the bootstrap: Rust → UNHINGED stage1 → UNHINGED stage2 (build/unhingedc), which must
# rebuild itself
unhinged:
	@mkdir -p build
	cargo build --release --manifest-path unhinged/bootstrap/Cargo.toml
	cp unhinged/bootstrap/target/release/unhingedc $(UNHINGEDC_BOOT)
	$(UNHINGEDC_BOOT) unhinged/compiler/src/main.uh -o $(UNHINGEDC_STAGE1)
	$(UNHINGEDC_STAGE1) unhinged/compiler/src/main.uh $(UNHINGEDC)

# the UNHINGED compiler's own tests (RUN_NET=1 and RUN_SMTP=1 add the network ones)
unhinged-test: unhinged
	UNHINGEDC=$(UNHINGEDC) $(UNHINGEDC) unhinged/tests/tests.uh $(UNHINGED_TESTS)
	$(UNHINGED_TESTS)

# s1: trithc, compiled by the UNHINGED compiler (spec §17)
trith: unhinged
	$(UNHINGEDC) trith/src/main.uh $(TRITHC)

trith-test: trith
	@mkdir -p output
	$(UNHINGEDC) trith/tests/run.uh $(TRITH_TESTS)
	TRITHC=$(TRITHC) $(TRITH_TESTS) | tee output/trith-tests.log
	@! grep -q '^FAIL' output/trith-tests.log

# valgrind over every program in trith/tests/run (needs valgrind)
trith-memcheck: trith
	TRITHC=$(TRITHC) trith/tests/memcheck.sh

# benchmark gate (spec §17): each program within 1.5× of clang -O2 C
trith-bench: trith
	TRITHC=$(TRITHC) trith/bench/run.sh

# sha256.trh is generated from sha256.trhx (written with the s2 shorthands)
bench-regen: trith
	@mkdir -p build
	python3 trith/s2/tools/trx.py trith/bench/sha256.trhx > build/sha256.logical.trh
	$(TRITHC) build/sha256.logical.trh --plough > trith/bench/sha256.trh

clean:
	rm -rf build output unhinged/bootstrap/target

# s2: the compiler rewritten in Trith (spec §17), compiled by s1. The sources
# in trith/s2/src are authored in logical order with named moments; the
# committed trith/s2/s2c.trh is generated from them by `make s2-regen`.
S2_SRC := trith/s2/src/util.trhx trith/s2/src/chars.trhx trith/s2/src/lexer.trhx trith/s2/src/planes.trhx trith/s2/src/parser.trhx trith/s2/src/heap.trhx trith/s2/src/types.trhx trith/s2/src/check.trhx trith/s2/src/emit.trhx trith/s2/src/eval.trhx trith/s2/src/curses.trhx trith/s2/src/main.trhx
s2: trith
	$(TRITHC) trith/s2/s2c.trh -o build/s2c

s2-regen: trith
	python3 trith/s2/tools/trx.py $(S2_SRC) > build/s2c.logical.trh
	$(TRITHC) build/s2c.logical.trh --plough > trith/s2/s2c.trh

s2-test: s2
	TRITHC=$(TRITHC) S2C=build/s2c trith/s2/test.sh

# golden tests for what only s2 implements (the addenda); BLESS=1 rewrites the .out files
s2-golden: s2
	S2C=build/s2c trith/s2/golden.sh

# s3 is s2 compiled by s2; the fixpoint (spec §17) is that it emits exactly what
# s2 emits, for its own source and for every test
s3: s2
	build/s2c trith/s2/s2c.trh -o build/s3c

s2-fixpoint: s3
	@mkdir -p output
	build/s2c trith/s2/s2c.trh --emit-llvm > output/s2.ll
	build/s3c trith/s2/s2c.trh --emit-llvm > output/s3.ll
	cmp output/s2.ll output/s3.ll
	cmp build/s2c build/s3c
	@echo "fixpoint: s3 emits exactly what s2 emits, and is the same executable"
	TRITHC=$(TRITHC) S2C=build/s3c trith/s2/test.sh

s2-fuzz: s2
	python3 trith/s2/tools/fuzz.py build/s2c $(TRITHC) output/s2-fuzz 1 1000
	python3 trith/s2/tools/fuzzparse.py build/s2c $(TRITHC) output/s2-fuzzparse 1 500
	python3 trith/s2/tools/fuzzcheck.py build/s2c $(TRITHC) output/s2-fuzzcheck 1 300

# the standard library (trith/lib): C modules bound with FFI. Each test is authored
# as trith/lib/tests/X.trhx; the committed X.trh is generated by `make lib-regen`.
# lib-test builds and runs them with s1 and with s2.
LIB_TESTS := crypto http json smtp ws
lib-regen: trith
	@mkdir -p build
	for n in $(LIB_TESTS); do \
		python3 trith/s2/tools/trx.py trith/lib/tests/$$n.trhx > build/lib-$$n.logical.trh && \
		$(TRITHC) build/lib-$$n.logical.trh --plough > trith/lib/tests/$$n.trh || exit 1; \
	done

lib-test: s2
	TRITHC=$(TRITHC) trith/lib/run.sh
	TRITHC=build/s2c trith/lib/run.sh
