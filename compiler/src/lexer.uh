⍝ Minimal lexer (token list: {kind, text})

ƒ
  【】 → tokens ¿
  0 → i ¿
  ⍝ Split into code points once; indexing the string itself is O(n) per call
  src ⟪ chars ⟫ → cs ¿
  cs ⟪ len ⟫ → n ¿

  i n ≺ ⟲ ↵
    cs i ⌈ ⌉ → ch ¿

    ch " " ≡ ch "\n" ≡ ∨ ch "\t" ≡ ∨ ⤴ ↵
      i 1 ⊞ → i ¿
      ⊕ ¿
    ⌫ ¿

    ch ":" ≡ ch "," ≡ ∨ ⤴ ↵
      i 1 ⊞ → i ¿
      ⊕ ¿
    ⌫ ¿

    ch "⍝" ≡ ⤴ ↵
      i 1 ⊞ → i ¿
      i n ≺ ⟲ ↵
        cs i ⌈ ⌉ → c2 ¿
        c2 "\n" ≡ ⤴ ↵
          i 1 ⊞ → i ¿
          ⊗ ¿
        ⌫ ¿
        i 1 ⊞ → i ¿
      ⌫ ¿
      ⊕ ¿
    ⌫ ¿

    ch "\"" ≡ ⤴ ↵
      i 1 ⊞ → i ¿
      "" → buf ¿
      i n ≺ ⟲ ↵
        cs i ⌈ ⌉ → c3 ¿
        c3 "\"" ≡ ⤴ ↵
          i 1 ⊞ → i ¿
          ⊗ ¿
        ⌫ ¿
        c3 "\\" ≡ ⤴ ↵
          i 1 ⊞ → i ¿
          i n ≺ ⤴ ↵
            cs i ⌈ ⌉ → esc ¿
            esc "n" ≡ ⤴ ↵ "\n" → esc ¿ ⌫ ¿
            esc "r" ≡ ⤴ ↵ "\r" → esc ¿ ⌫ ¿
            esc "t" ≡ ⤴ ↵ "\t" → esc ¿ ⌫ ¿
            esc "\"" ≡ ⤴ ↵ "\"" → esc ¿ ⌫ ¿
            esc "\\" ≡ ⤴ ↵ "\\" → esc ¿ ⌫ ¿
            buf esc ⊞⊞ → buf ¿
            i 1 ⊞ → i ¿
            ⊕ ¿
          ⌫ ¿
        ⌫ ¿
        buf c3 ⊞⊞ → buf ¿
        i 1 ⊞ → i ¿
      ⌫ ¿
      ❴"kind": "string", "text": buf❵ → tok ¿
      tokens tok ⟪ .append ⟫ → tokens ¿
      ⊕ ¿
    ⌫ ¿

    ch "0" ≽ ch "9" ≼ ∧ ⤴ ↵
      i → start ¿
      ⊥ → sawDot ¿
      i n ≺ ⟲ ↵
        cs i ⌈ ⌉ → c4 ¿
        c4 "0" ≽ c4 "9" ≼ ∧ ⤴ ↵
          i 1 ⊞ → i ¿
          ⊕ ¿
        ⌫ ¿
        c4 "." ≡ sawDot ⊥ ≡ ∧ ⤴ ↵
          i 1 ⊞ → ip1 ¿
          ip1 n ≺ ⤴ ↵
            cs ip1 ⌈ ⌉ → c5 ¿
            c5 "0" ≽ c5 "9" ≼ ∧ ⤴ ↵
              ⊤ → sawDot ¿
              i 1 ⊞ → i ¿
              ⊕ ¿
            ⌫ ¿
          ⌫ ¿
        ⌫ ¿
        ⊗ ¿
      ⌫ ¿
      i start ⊟ → len ¿
      cs start i ⟪ lex_join ⟫ → buf ¿
      ❴"kind": "number", "text": buf❵ → tok ¿
      tokens tok ⟪ .append ⟫ → tokens ¿
      ⊕ ¿
    ⌫ ¿

    ch "_" ≡ ch "." ≡ ∨ ch "a" ≽ ch "z" ≼ ∧ ∨ ch "A" ≽ ch "Z" ≼ ∧ ∨ ch "⍺" ≡ ∨ ch "⍵" ≡ ∨ ch "⍹" ≡ ∨ ch "⎕" ≡ ∨ ⤴ ↵
      i → start ¿
      i n ≺ ⟲ ↵
        cs i ⌈ ⌉ → c5 ¿
        c5 "_" ≡ c5 "." ≡ ∨ c5 "a" ≽ c5 "z" ≼ ∧ ∨ c5 "A" ≽ c5 "Z" ≼ ∧ ∨ c5 "0" ≽ c5 "9" ≼ ∧ ∨ c5 "⍺" ≡ ∨ c5 "⍵" ≡ ∨ c5 "⍹" ≡ ∨ c5 "⎕" ≡ ∨ ⤴ ↵
          i 1 ⊞ → i ¿
          ⊕ ¿
        ⌫ ¿
        ⊗ ¿
      ⌫ ¿
      i start ⊟ → len ¿
      cs start i ⟪ lex_join ⟫ → buf ¿
      ❴"kind": "ident", "text": buf❵ → tok ¿
      tokens tok ⟪ .append ⟫ → tokens ¿
      ⊕ ¿
    ⌫ ¿

    i 1 ⊞ → ip1 ¿
    ip1 n ≺ ⤴ ↵
      cs ip1 ⌈ ⌉ → ch2 ¿
      ch ch2 ⊞⊞ → pair ¿
      pair "⊞⊞" ≡ pair "⊟⊟" ≡ ∨ pair "⊕⊕" ≡ ∨ ⤴ ↵
        ❴"kind": "symbol", "text": pair❵ → tok ¿
        tokens tok ⟪ .append ⟫ → tokens ¿
        i 2 ⊞ → i ¿
        ⊕ ¿
      ⌫ ¿
    ⌫ ¿

    ❴"kind": "symbol", "text": ch❵ → tok ¿
    tokens tok ⟪ .append ⟫ → tokens ¿
    i 1 ⊞ → i ¿
  ⌫ ¿

  tokens ⇄ ¿
↦ src ↦ lex ¿

⍝ Join code points cs[a..b) into a string
ƒ
  【】 → parts ¿
  a → k ¿
  k b ≺ ⟲ ↵
    parts cs k ⌈ ⌉ ⟪ .append ⟫ → parts ¿
    k 1 ⊞ → k ¿
  ⌫ ¿
  parts "" ⟪ join ⟫ ⇄ ¿
↦ cs ↦ a ↦ b ↦ lex_join ¿
