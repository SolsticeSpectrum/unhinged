      ⦃ ⧖:C,j,end,ev ⧗:C̵,j ‹rd› ⧖:C,c ⧗:C̵ ⧗:j △ ⊞ ⧗:end
        ⧗:ev ⧗:c #8278# ᛖ ⋔ ⦃ △ ‹evmax› ⦄ ∅ ⁼ ⧗:c #11822# ᛖ ⋔ ⦃ #2# ‹evmax› ⦄ ∅ ⁼ ⊕ ⦄
  ⦄
  ⧖:C,j,end,ev ⧗:C̵,ev
⦄ ⟨⟦ℤ⟧ ℤ ℤ ⊸ ⟦ℤ⟧ ℤ⟩ ‹tokev› ⸫

⦃
  ⧖:C,i,np,bt,k
  ⧗:C̵,i ○ ○ ⧗:np
  ⥀ ⦃
    ⧖:C,i,ev,j,np
    ⧗:C̵,i,ev,j,np ⧗:j ⧗:np ≶ ⋔ ⦃ ⦶ ⦄ ⁼
      ⦃ ⧖:C,i,ev,j,np ⧗:C̵,i ⧗:j #4# ⊞ ‹nd› ‹tabs› ⧖:C,t ⧗:C̵,t,ev ‹tokev› ⧖:C,ev2 ⧗:C̵,i,ev2 ⧗:j △ ⊞ ⧗:np ⊕ ⦄
  ⦄
  ⧖:C,i,ev,j,np
  ⧗:C̵,bt,ev ⧗:k #9# ᛖ ⋔ ⦃ ‹tokev› ⦄ ⦃ ⧖:e ⌁ ⧗:e ⦄ ⁼
⦄ ⟨⟦ℤ⟧ ℤ ℤ ℤ ℤ ⊸ ⟦ℤ⟧ ℤ⟩ ‹tyev› ⸫

⍝ ---- values: [type id token region of role ev ch]; a moment has void in place of role

