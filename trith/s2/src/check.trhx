  ⧗:C̵,n1 #8862# ‹isglyphn› ⧖:C,u1 ⧗:C̵,n1 #8863# ‹isglyphn› ⧖:C,u2 ⧗:C̵,n1 #10849# ‹isglyphn› ⧖:C,u3
  ⧗:C̵,n1 ‹isintlit› ⧖:C,l1 ⧗:C̵,n2 #8822# ‹isglyphn› ⧖:C,cmp ⧗:C̵,n3 ○ ‹nd› ⧖:C,k3
  ⧗:C̵ ○
  ⧗:pick ⧗:idx ○ ᛖ ⋎ ⧗:n3 ⧗:to ≶ ⋔ ⦃ ⊕ ⦄ ⁼ ⦃ ⦶ ⦄ ⋎ ⧗:l1 ⋎ ⧗:cmp ⋎ ⧗:k3 #11# ᛖ ⋎ ⋔ ⦃ ⌁ #3# ⦄ ∅ ⁼
  ⧗:lit ⧗:pick ⧗:idx ○ ≶ ⋔ ⦃ ⊕ ⦄ ⦃ ⦶ ⦄ ⦃ ⊕ ⦄ ⋎ ⋏ ⧗:n1 ⧗:to ≶ ⋔ ⦃ ⊕ ⦄ ⁼ ⦃ ⦶ ⦄ ⋎ ⧗:u1 ⧗:u2 ⋏ ⧗:u3 ⋏ ⋎ ⋔ ⦃ ⌁ #2# ⦄ ∅ ⁼
  ⧗:k #2# ᛖ ⧗:k #4# ᛖ ⋏ ⋔ ⦃ ⌁ △ ⦄ ∅ ⁼
  ⧗:neg ⋔ ⦃ ⌁ #4# ⦄ ∅ ⁼
⦄ ⟨⟦ℤ⟧ ℤ ℤ ℤ ℤ ℤ ℤ ⊸ ⟦ℤ⟧ ℤ⟩ ‹rvcode› ⸫

⦃
  ⧖:C,i,to,k,tok,n1,n2,n3
  ⧗:C̵,i ‹resolve› ⧖:C,f
  ⧗:C̵,f #3# ‹vf› ⧖:C,rev
  ⧗:C̵,tok ⧗:rev △ ᛖ ⋔ ⦃ ⌁ ⦄ ⦃ ⧖:tk ⧗:tk ‹cerr› $a reversible function can only call reversible functions, and $ ⎙̵ ⧗:tk ‹ptx› $ is not ⇋ (§10)$ ⎙̵ ‹die› ⦄ ⁼ ⧖:C
  ⧗:C̵,tok #3# ‹tf› ⧖:C,m
  ⧗:C̵ ⧗:m ○ ᛖ ⧗:tok #21# ‹cfailunless›
