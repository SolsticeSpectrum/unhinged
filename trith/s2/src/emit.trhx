⍝ an operator: unwrap the operands (all but ⌁'s), mark integer literals next to bytes as bytes,
⍝ fold what is known (§13), lift over superpositions, else emit
⦃
  ⧖:C,S,strand,dead,tok,x,idx,role,op,to
  ⧗:x ‹arity› ⧖:ar0
  ⧗:ar0 ⧗:ar0 #-1# ᛖ ⋔ ⦃ ⌁ △ ⦄ ∅ ⁼ ⧖:ar
  ⧗:C,S,ar ‹epop› ⧖:C,S2,vals
  ⧗:C ‹qnew› ⧖:C,q
  ⧗:C,vals,q,x ○ ⧗:ar
  ⥀ ⦃
    ⧖:C,vals,q,x,i,ar
    ⧗:C,vals,q,x,i,ar ⧗:i ⧗:ar ≶ ⋔ ⦃ ⦶ ⦄ ⁼
      ⦃ ⧖:C,vals,q,x,i,ar ⧗:C,vals,i ‹lget› ⧖:C,e ⧗:C,e ⧗:x #8961# ᛖ ⋔ ⦃ ⦄ ⦃ ‹eunwrap› ⦄ ⁼ ⧖:C,e2 ⧗:C,q,e2 ‹qadd› ⧗:vals,q,x ⧗:i △ ⊞ ⧗:ar ⊕ ⦄
  ⦄
  ⧖:C,vals,q,x,i,ar
  ⧗:C,q ‹qlist› ⧖:C,uv
  ⧗:C,uv,ar ‹ehasbyte› ⧖:C,hb
  ⧗:C,uv,ar,x ⧗:hb ⧗:x #8982# ᛖ ‹not› ⋎ ⋔ ⦃ ‹ebytelits› ⦄ ⦃ ⌁ ⌁ ⌁ ⦄ ⁼ ⧖:C
  ⧗:C,x,uv,ar ‹efold› ⧖:C,res0
  ⧗:C,uv,ar ‹eanypsi› ⧖:C,psi
  ⧗:C,tok,uv,res0 ⧗:psi ⋔ ⦃ ⌁ ‹elift› ⦄ ⦃ ⧖:tk,u,r ⧗:r ⦄ ⁼ ⧖:C,res1
  ⧗:C,tok,uv,res1 ⧗:res1 #-1# ᛖ ⋔ ⦃ ⌁ ‹eglyph› ⦄ ⦃ ⧖:tk,u,r ⧗:r ⦄ ⁼ ⧖:C,res
  ⧗:C,S2,res ‹lcat› ⧗:strand,dead
⦄ ⟨⟦ℤ⟧ ℤ ℤ ℤ ℤ ℤ ℤ ℤ ℤ ℤ ⊸ ⟦ℤ⟧ ℤ ℤ ℤ⟩ ‹eo_glyph› ⸫
