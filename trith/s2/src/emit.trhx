⍝ ‹efold› C x uv n: the entries the operator gives, or −1 when it cannot be folded
⦃
  ⧖:C,x,uv,n
  ⧗:x ⧖ @any(8862,8863,8864,8856,8860,8861,8822,8911,8910,9863)@ ⧖:foldable
  ⧗:C,uv,n ‹eknown› ⧖:C,known
  ⧗:C,x,uv,n ⧗:foldable ⧗:known ⋎ ⋔ ⦃ ‹efold1› ⦄ ⦃ ⌁ ⌁ ⌁ #-1# ⦄ ⁼
⦄ ⟨⟦ℤ⟧ ℤ ℤ ℤ ⊸ ⟦ℤ⟧ ℤ⟩ ‹efold› ⸫
⦃
  ⧖:C,x,uv,n
  ⧗:C,uv ○ ‹lget› ⧖:C,e0
  ⧗:C,e0 ‹ety› ⧖:C,ty ⧗:C,e0 #5# ‹vf› ⧖:C,a
  ⧗:C,uv,n ⧗:n △ ≶ ⋔ ⦃ ⌁ ⌁ ○ ⦄ ⦃ ⌁ △ ‹lget› #5# ‹vf› ⦄ ⦃ ⌁ ⌁ ○ ⦄ ⧖:C,b
  ⧗:C,ty #10# ‹tis› ⧖:C,tr ⧗:C,ty #11# ‹tis› ⧖:C,iz
  ⧗:C,x,ty,a,b ⧗:tr ⧗:iz ⋏ ⋔ ⦃ ‹evglyph› ⦄ ⦃ ⌁ ⌁ ⌁ ⌁ #-1# ⦄ ⁼
