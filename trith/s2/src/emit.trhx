⍝ not hoisted (a join came first): filter the moment from here on
⦃
  ⧖:C,S,strand,fe,prev
  ⧗:C̵,prev ‹ndt› #4# ‹tf› ⧖:C,n
  ⧗:C̵,strand ‹llen› ⧖:C,ns
  ⧗:ns △ ⊟ ⧗:n ⊟ ⧖:mi
  ⧗:C̵,strand ‹lcopy› ⧖:C,st2
  ⧗:C̵,st2,mi,fe ‹lset›
  ⧗:S,st2
⦄ ⟨⟦ℤ⟧ ℤ ℤ ℤ ℤ ⊸ ⟦ℤ⟧ ℤ ℤ⟩ ‹epostmoment› ⸫
⍝ ‹ekey› C tok: "line:col" of a token, interned
⦃ ⧖:C,tok ⧗:C̵,tok △ ‹tf› ⧖:C,ln ⧗:C̵,tok #2# ‹tf› ⧖:C,cl ⧗:C̵ %%!{#ln}:{#cl}%% ⦄ ⟨⟦ℤ⟧ ℤ ⊸ ⟦ℤ⟧ ℤ⟩ ‹ekey› ⸫
⍝ ‹eisread› C n: node n is an op ⧗ (n −1: no node)
⦃
  ⧖:C,n
  ⧗:C̵,n ⧗:n #-1# ᛖ ⋔ ⦃ ⌁ ⊕ ⦄ ⦃ #10711# ‹isglyphn› ⦄ ⁼
⦄ ⟨⟦ℤ⟧ ℤ ⊸ ⟦ℤ⟧ ŧ⟩ ‹eisread› ⸫

⍝ ‹eretro› C e op to: retrocausality (§8.5): a ⧗ⁿ ⟜ later in this block that reads the moment
⍝ just bound (by ⧖ op) is applied here, at the definition, so every read sees it
⦃
  ⧖:C,e,op,to
  ⧗:C̵,op ‹nextn› ⧖:C,j
  ⧗:C̵,e,j,to ○ ⦶
  ⥀ ⦃
    ⧖:C,e,j,to,binds,go
    ⧗:C̵,j ‹nextn› ⧖:C,j1
    ⧗:C̵,e,j,to,binds ⧗:go ⧗:j1 ⧗:to ≶ ⋔ ⦃ ⊕ ⦄ ⁼ ⦃ ⦶ ⦄ ⋎ ⋔ ⦃ ‹eretro1› ⦄ ⦃ ⊕ ⦶ ⦄ ⁼
  ⦄
  ⧖:C,e,j,to,binds,go ⧗:C̵,e
⦄ ⟨⟦ℤ⟧ ℤ ℤ ℤ ⊸ ⟦ℤ⟧ ℤ⟩ ‹eretro› ⸫
⦃
  ⧖:C,e,j,to,binds
  ⧗:C̵,j ○ ‹nd› ⧖:C,k
  ⧗:k ⧖ @any(10,11,17,14)@ ⧖:stop
  ⧗:C̵,j #10710# ‹isglyphn› ⧖:C,isbind
  ⧗:binds ⧗:binds △ ⊞ ⧗:isbind ⋔ ⦃ ⧖ ⌁ ⧗⁰ ⦄ ⦃ ⌁ ⦄ ⁼ ⧖:b2
  ⧗:C̵,j ‹nextn› ⧖:C,j2
  ⧗:C̵,j #10711# ‹isglyphn› ⧖:C,isread
  ⧗:C̵,j2 ○ ‹nd› ⧖:C,k2
  ⧗:C̵,j ‹ndt› #4# ‹tf› ⧖:C,idx
  ⧗:isread ⧗:k2 #15# ᛖ ⋎ ⧗:idx ⧗:b2 ᛖ ⋎ ⧗:stop ‹not› ⋎ ⧖:apply
  ⧗:C̵,e,j2 ⧗:apply ⋔ ⦃ ‹eretro2› ⦄ ⦃ ⌁ ⦄ ⁼ ⧖:C,e2
  ⧗:C̵,e2,j2,to,b2 ⧗:stop ‹not› ⧗:stop
⦄ ⟨⟦ℤ⟧ ℤ ℤ ℤ ℤ ⊸ ⟦ℤ⟧ ℤ ℤ ℤ ℤ ŧ ŧ⟩ ‹eretro1› ⸫
⦃
  ⧖:C,e,j2
  ⧗:C̵ ⧗:j2 #3# ⊞ ⧖:C,b
  ⧗:C̵,e,b ‹epost› ⧖:C,e2
  ⧗:C̵,j2 ‹ndt› ‹ekey› ⧖:C,key
  ⧗:C̵ #35# ‹reg› ⧖:C,hq ⧗:C̵,hq,key ‹qadd›
  ⧗:e2
⦄ ⟨⟦ℤ⟧ ℤ ℤ ⊸ ⟦ℤ⟧ ℤ⟩ ‹eretro2› ⸫
