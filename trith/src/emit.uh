      E ⟪ em_failed ⟫ ⤴ ↵ ⊗ ¿ ⌫ ¿
      r "stack" ⌈ ⌉ → BS ¿
      E "cur" ⌈ ⌉ → latch ¿
      ∅ → te ¿
      r "dead" ⌈ ⌉ ¬ ⤴ ↵
        BS ⟪ .pop ⟫ → te ¿
        E te exit head lfail ⟪ em_branch3 ⟫ → edges ¿
        0 → q ¿
        edges ⟪ len ⟫ → ne ¿
        q ne ≺ ⟲ ↵
          edges q ⌈ ⌉ → ed ¿
          ed 1 ⌈ ⌉ head ≡ ⤴ ↵ ed 0 ⌈ ⌉ → latch ¿ ⌫ ¿
          q 1 ⊞ → q ¿
        ⌫ ¿
      ⌫ ¿
      0 → q ¿
      patches ⟪ len ⟫ → np ¿
      q np ≺ ⟲ ↵
        patches q ⌈ ⌉ → pt ¿
        pt 0 ⌈ ⌉ → at ¿
        pt 1 ⌈ ⌉ → name ¿
        pt 2 ⌈ ⌉ → vt ¿
        pt 3 ⌈ ⌉ → j ¿
        pt 4 ⌈ ⌉ → fld ¿
        S j ⌈ ⌉ fld ⌈ ⌉ → v0 ¿
        【"  " name " = phi " vt " [ " v0 ", %" pre " ]"】 ⟪ em_cat ⟫ → line ¿
        r "dead" ⌈ ⌉ ¬ ⤴ ↵
          BS j ⌈ ⌉ fld ⌈ ⌉ → v1 ¿
          【line ", [ " v1 ", %" latch " ]"】 ⟪ em_cat ⟫ → line ¿
        ⌫ ¿
        E "lines" ⌈ ⌉ → LL ¿
        LL at ← line ¿
        q 1 ⊞ → q ¿
      ⌫ ¿
      r "dead" ⌈ ⌉ ⤴ ↵
        ⊤ → dead ¿
      ⌫ ⤵ ↵
        E lfail ⟪ em_start ⟫ ¿
        E ⟪ em_fail_exit ⟫ ¿
        E exit ⟪ em_start ⟫ ¿
        BS → S ¿
        strand r "strand" ⌈ ⌉ ⊞⊞ → strand ¿
      ⌫ ¿
    ⌫ ⤵ ↵
      "4" → m ¿
      k "postselect" ≡ k "rselect" ≡ ∨ k "inverse-call" ≡ ∨ ⤴ ↵ "5" → m ¿ ⌫ ¿
      tok ⟪ ck_label ⟫ → lbl ¿
      E tok 【"code generation for " lbl " arrives in milestone " m】 ⟪ em_cat ⟫ ⟪ em_err ⟫ ¿
    ⌫ ¿
    E ⟪ em_failed ⟫ ⤴ ↵ ⊗ ¿ ⌫ ¿
    oi 1 ⊞ → oi ¿
  ⌫ ¿
  S strand dead ⟪ ck_result ⟫ ⇄ ¿
↦ E ↦ ops ↦ S ↦ em_block ¿

ƒ
  0 → i ¿
  src ⟪ len ⟫ → n ¿
  i n ≺ ⟲ ↵
    dst src i ⌈ ⌉ ⟪ .append ⟫ ¿
    i 1 ⊞ → i ¿
  ⌫ ¿
  ∅ ⇄ ¿
↦ dst ↦ src ↦ em_concat_into ¿

⍝ ---- functions and module

ƒ
  f "ins" ⌈ ⌉ → ins ¿
  f "outs" ⌈ ⌉ → outs ¿
  f "sym" ⌈ ⌉ → sym ¿
  it "tok" ⌈ ⌉ → tok ¿
  0 → i ¿
  ins outs ⊞⊞ → all ¿
  all ⟪ len ⟫ → n ¿
  i n ≺ ⟲ ↵
    E all i ⌈ ⌉ tok ⟪ em_need_type ⟫ ¿
    E ⟪ em_failed ⟫ ⤴ ↵ ∅ ⇄ ¿ ⌫ ¿
    i 1 ⊞ → i ¿
  ⌫ ¿
  E "tmp" ← 0 ¿
  E "lbl" ← 0 ¿
  E "defers" ← 【】 ¿
  ⊥ → canFail ¿
  outs ⟪ len ⟫ 1 ≡ ⤴ ↵ outs 0 ⌈ ⌉ ⟪ em_is_fail ⟫ → canFail ¿ ⌫ ¿
  ∅ → failRet ¿
  canFail ⤴ ↵
    outs 0 ⌈ ⌉ → o ¿
    o "◌" ≡ ⤴ ↵ "ret i1 false" → failRet ¿ ⌫ ⤵ ↵
      o ⟪ em_llty ⟫ → st ¿
      【"ret " st " zeroinitializer"】 ⟪ em_cat ⟫ → failRet ¿
    ⌫ ¿
  ⌫ ¿
  E "failRet" ← failRet ¿
  【】 → params ¿
  【】 → S ¿
  E "lines" ⌈ ⌉ "" ⟪ .append ⟫ ¿
  0 → i ¿
  ins ⟪ len ⟫ → n ¿
  i n ≺ ⟲ ↵
    ins i ⌈ ⌉ → t ¿
    t ⟪ em_llty ⟫ → lt ¿
    i ⍕ → is ¿
    【"%a" is】 ⟪ em_cat ⟫ → pn ¿
    params 【lt " " pn】 ⟪ em_cat ⟫ ⟪ .append ⟫ ¿
    i 1 ⊞ → i ¿
  ⌫ ¿
  params ", " ⟪ join ⟫ → pt ¿
  outs ⟪ em_ret_ty ⟫ → rt ¿
  it "name" ⌈ ⌉ → nm ¿
  E "lines" ⌈ ⌉ 【"; " nm】 ⟪ em_cat ⟫ ⟪ .append ⟫ ¿
  E "lines" ⌈ ⌉ 【"define internal " rt " " sym "(" pt ") {"】 ⟪ em_cat ⟫ ⟪ .append ⟫ ¿
  E "entry" ⟪ em_start ⟫ ¿
  0 → i ¿
  i n ≺ ⟲ ↵
    i ⍕ → is ¿
    【"%a" is】 ⟪ em_cat ⟫ → pn ¿
    S E ins i ⌈ ⌉ pn ⟪ em_unpack ⟫ ⟪ .append ⟫ ¿
    i 1 ⊞ → i ¿
  ⌫ ¿
  E ⟪ em_push_frame ⟫ ¿
  E it "ops" ⌈ ⌉ S ⟪ em_block ⟫ → r ¿
  E ⟪ em_pop_frame ⟫ → frame ¿
  E ⟪ em_failed ⟫ ⤴ ↵ ∅ ⇄ ¿ ⌫ ¿
  r "dead" ⌈ ⌉ ¬ ⤴ ↵
    E frame ⟪ em_run_frame ⟫ ¿
    r "stack" ⌈ ⌉ → FS ¿
    outs ⟪ len ⟫ 0 ≡ ⤴ ↵
      E "ret void" ⟪ em_emit ⟫ ¿
    ⌫ ⤵ outs ⟪ len ⟫ 1 ≡ ⤴ ↵
      ∅ → e ¿
      FS ⟪ len ⟫ 0 ≻ ⤴ ↵ FS 0 ⌈ ⌉ → e ¿ ⌫ ¿
      E e outs 0 ⌈ ⌉ ⟪ em_pack ⟫ → rv ¿
      E 【"ret " rt " " rv】 ⟪ em_cat ⟫ ⟪ em_emit ⟫ ¿
    ⌫ ⤵ ↵
      "undef" → agg ¿
      0 → i ¿
      outs ⟪ len ⟫ → no ¿
      i no ≺ ⟲ ↵
        outs i ⌈ ⌉ → o ¿
        o ⟪ em_llty ⟫ → ot ¿
        E FS i ⌈ ⌉ o ⟪ em_pack ⟫ → pv ¿
        i ⍕ → is ¿
        E 【"insertvalue " rt " " agg ", " ot " " pv ", " is】 ⟪ em_cat ⟫ ⟪ em_def ⟫ → agg ¿
        i 1 ⊞ → i ¿
      ⌫ ¿
      E 【"ret " rt " " agg】 ⟪ em_cat ⟫ ⟪ em_emit ⟫ ¿
    ⌫ ¿
  ⌫ ¿
  E "lines" ⌈ ⌉ "}" ⟪ .append ⟫ ¿
  ∅ ⇄ ¿
↦ E ↦ it ↦ f ↦ em_function ¿

⍝ items (checked) → ❴ir, err❵
ƒ
  ❴"err": ∅, "path": path, "sn": 0, "debug": debug❵ → E ¿
  E "lines" ← 【】 ¿
  E "globals" ← 【】 ¿
  E "cur" ← "entry" ¿
  ❴❵ → fns ¿
  ❴❵ → shapes ¿
  E "fns" ← fns ¿
  E "shapes" ← shapes ¿
  ∅ → entry ¿
  0 → i ¿
  items ⟪ len ⟫ → n ¿
  i n ≺ ⟲ ↵
    items i ⌈ ⌉ → it ¿
    it "kind" ⌈ ⌉ "fn" ≢ ⤴ ↵
      E it "tok" ⌈ ⌉ "code generation for particles and FFI bindings arrives in milestone 4" ⟪ em_err ⟫ ¿
      ⊗ ¿
    ⌫ ¿
    it "sig" ⌈ ⌉ it "rev" ⌈ ⌉ it "name" ⌈ ⌉ ⟪ ck_fn_info ⟫ → f ¿
    it "name" ⌈ ⌉ → nm ¿
    f "sym" ← 【"@\"trith." nm "\""】 ⟪ em_cat ⟫ ¿
    fns nm ← f ¿
    it "sig" ⌈ ⌉ ⟪ ck_shape ⟫ → key ¿
    key shapes ∈ ¬ ⤴ ↵ shapes key ← 【】 ¿ ⌫ ¿
    shapes key ⌈ ⌉ nm ⟪ .append ⟫ ¿
    nm "ᛟ" ≡ ⤴ ↵ f → entry ¿ ⌫ ¿
    i 1 ⊞ → i ¿
  ⌫ ¿
  E ⟪ em_failed ⟫ ¬ entry ∅ ≡ ∧ ⤴ ↵ E ∅ "a program needs an entry point ᛟ ⟨⊸⟩" ⟪ em_err ⟫ ¿ ⌫ ¿
  0 → i ¿
  i n ≺ E ⟪ em_failed ⟫ ¬ ∧ ⟲ ↵
    items i ⌈ ⌉ → it ¿
    E it fns it "name" ⌈ ⌉ ⌈ ⌉ ⟪ em_function ⟫ ¿
    i 1 ⊞ → i ¿
  ⌫ ¿
  E "err" ⌈ ⌉ → err ¿
  err ∅ ≢ ⤴ ↵ ❴"ir": "", "err": err❵ ⇄ ¿ ⌫ ¿
  【】 → out ¿
  out "; generated by trithc (s1)" ⟪ .append ⟫ ¿
  out "declare ptr @trith_str_new(ptr, i64)" ⟪ .append ⟫ ¿
  out "declare void @trith_str_free(ptr)" ⟪ .append ⟫ ¿
  out "declare void @trith_print_str(ptr)" ⟪ .append ⟫ ¿
  out "declare void @trith_print_i64(i64)" ⟪ .append ⟫ ¿
  out "declare void @trith_print_f64(double)" ⟪ .append ⟫ ¿
  out "declare void @trith_loop_failed()" ⟪ .append ⟫ ¿
  out "declare void @trith_entry_failed()" ⟪ .append ⟫ ¿
  out "declare void @llvm.assume(i1)" ⟪ .append ⟫ ¿
  out "declare void @llvm.trap()" ⟪ .append ⟫ ¿
  out E "globals" ⌈ ⌉ ⟪ em_concat_into ⟫ ¿
  out E "lines" ⌈ ⌉ ⟪ em_concat_into ⟫ ¿
  out "" ⟪ .append ⟫ ¿
  entry "sym" ⌈ ⌉ → es ¿
  out "define i32 @main() {" ⟪ .append ⟫ ¿
  out "entry:" ⟪ .append ⟫ ¿
  entry "outs" ⌈ ⌉ ⟪ len ⟫ 0 ≡ ⤴ ↵
    out 【"  call void " es "()"】 ⟪ em_cat ⟫ ⟪ .append ⟫ ¿
    out "  ret i32 0" ⟪ .append ⟫ ¿
  ⌫ ⤵ ↵
    out 【"  %r = call i1 " es "()"】 ⟪ em_cat ⟫ ⟪ .append ⟫ ¿
    out "  br i1 %r, label %ok, label %bad" ⟪ .append ⟫ ¿
    out "ok:" ⟪ .append ⟫ ¿
    out "  ret i32 0" ⟪ .append ⟫ ¿
    out "bad:" ⟪ .append ⟫ ¿
    out "  call void @trith_entry_failed()" ⟪ .append ⟫ ¿
    out "  ret i32 27" ⟪ .append ⟫ ¿
  ⌫ ¿
  out "}" ⟪ .append ⟫ ¿
  out "\n" ⟪ join ⟫ → ir ¿
  ❴"ir": ir, "err": ∅❵ ⇄ ¿
↦ items ↦ path ↦ debug ↦ trith_emit ¿
