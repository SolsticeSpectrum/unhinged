  t "ℝ" ≡ ⤴ ↵ "double" ⇄ ¿ ⌫ ¿
  t "ŧ" ≡ ⤴ ↵ "int8_t" ⇄ ¿ ⌫ ¿
  t "𝔹" ≡ ⤴ ↵ "uint8_t" ⇄ ¿ ⌫ ¿
  t ⟪ em_strip_ref ⟫ → b ¿
  b "ʃ" ≡ b ⟪ ck_head ⟫ "⟦" ≡ ∨ ⤴ ↵ "TrithStr *" ⇄ ¿ ⌫ ¿
  t ⟪ ck_head ⟫ "⟗" ≡ ⤴ ↵ b ⟪ em_ctype ⟫ ⇄ ¿ ⌫ ¿
  ∅ ⇄ ¿
↦ t ↦ em_ctype ¿

⍝ C wrapper for binding it; returns ❴sym, decl, c❵
ƒ
  f "ins" ⌈ ⌉ → ins ¿
  f "outs" ⌈ ⌉ → outs ¿
  it "tok" ⌈ ⌉ → tok ¿
  it "cname" ⌈ ⌉ → cname ¿
  k ⍕ → ks ¿
  【"trith_ffi_" ks】 ⟪ em_cat ⟫ → cfn ¿
  outs ⟪ len ⟫ 1 ≻ ⤴ ↵ E tok "an FFI binding returns at most one value" ⟪ em_err ⟫ ¿ ∅ ⇄ ¿ ⌫ ¿
  【】 → cps ¿
  【】 → lps ¿
  【】 → cargs ¿
  【】 → frees ¿
  0 → i ¿
  ins ⟪ len ⟫ → n ¿
  i n ≺ ⟲ ↵
    ins i ⌈ ⌉ → t ¿
    t ⟪ em_ctype ⟫ → ct ¿
    ct ∅ ≡ ⤴ ↵ E tok 【"an FFI binding cannot take " t】 ⟪ em_cat ⟫ ⟪ em_err ⟫ ¿ ∅ ⇄ ¿ ⌫ ¿
    i ⍕ → is ¿
    【"a" is】 ⟪ em_cat ⟫ → an ¿
    cps 【ct " " an】 ⟪ em_cat ⟫ ⟪ .append ⟫ ¿
    lps t ⟪ em_llty ⟫ ⟪ .append ⟫ ¿
    t ⟪ em_strip_ref ⟫ → b ¿
    b "ʃ" ≡ ⤴ ↵
      cargs 【"trith_str_cstr(" an ")"】 ⟪ em_cat ⟫ ⟪ .append ⟫ ¿
      t "ʃ" ≡ ⤴ ↵ frees 【"    trith_str_free(" an ");"】 ⟪ em_cat ⟫ ⟪ .append ⟫ ¿ ⌫ ¿
    ⌫ ⤵ b ⟪ ck_head ⟫ "⟦" ≡ ⤴ ↵
      t b ≡ ⤴ ↵ E tok "an FFI binding takes arrays only as shadows ⟗⟦T⟧ or ⟖⟦T⟧" ⟪ em_err ⟫ ¿ ∅ ⇄ ¿ ⌫ ¿
      cargs 【"(void *)" an "->ptr"】 ⟪ em_cat ⟫ ⟪ .append ⟫ ¿
    ⌫ ⤵ ↵
      cargs an ⟪ .append ⟫ ¿
    ⌫ ¿
    i 1 ⊞ → i ¿
  ⌫ ¿
  cps ", " ⟪ join ⟫ → cpt ¿
  cpt "" ≡ ⤴ ↵ "void" → cpt ¿ ⌫ ¿
  cargs ", " ⟪ join ⟫ → cat ¿
  lps ", " ⟪ join ⟫ → lpt ¿
  frees "\n" ⟪ join ⟫ → fr ¿
  【cname "(" cat ")"】 ⟪ em_cat ⟫ → callx ¿
  【】 → body ¿
  outs ⟪ len ⟫ 0 ≡ ⤴ ↵
    "void" → cret ¿
    "void" → lret ¿
    body 【"    " callx ";"】 ⟪ em_cat ⟫ ⟪ .append ⟫ ¿
    fr "" ≢ ⤴ ↵ body fr ⟪ .append ⟫ ¿ ⌫ ¿
  ⌫ ⤵ ↵
    outs 0 ⌈ ⌉ ⟪ em_ffi_base ⟫ → base ¿
    base ⟪ em_ctype ⟫ → cret ¿
    cret ∅ ≡ base ⟪ ck_head ⟫ "⟦" ≡ ∨ ⤴ ↵ E tok 【"an FFI binding cannot return " base】 ⟪ em_cat ⟫ ⟪ em_err ⟫ ¿ ∅ ⇄ ¿ ⌫ ¿
    base ⟪ em_llty ⟫ → lret ¿
    base "ʃ" ≡ ⤴ ↵
      body 【"    TrithStr *r = trith_str_from_cstr(" callx ");"】 ⟪ em_cat ⟫ ⟪ .append ⟫ ¿
    ⌫ ⤵ ↵
      body 【"    " cret " r = (" cret ")" callx ";"】 ⟪ em_cat ⟫ ⟪ .append ⟫ ¿
    ⌫ ¿
    fr "" ≢ ⤴ ↵ body fr ⟪ .append ⟫ ¿ ⌫ ¿
    body "    return r;" ⟪ .append ⟫ ¿
  ⌫ ¿
  body "\n" ⟪ join ⟫ → bt ¿
  【"\n" cret " " cfn "(" cpt ") {\n" bt "\n}"】 ⟪ em_cat ⟫ → c ¿
  【"declare " lret " @" cfn "(" lpt ")"】 ⟪ em_cat ⟫ → decl ¿
  【"@" cfn】 ⟪ em_cat ⟫ → sym ¿
  ❴"sym": sym, "decl": decl, "c": c❵ ⇄ ¿
↦ E ↦ it ↦ f ↦ k ↦ em_ffi ¿

⍝ items (checked) → ❴ir, err❵
ƒ
  ❴"err": ∅, "path": path, "sn": 0, "debug": debug❵ → E ¿
  E "hoisted" ← 【】 ¿
  E "lines" ← 【】 ¿
  E "globals" ← 【】 ¿
  E "cur" ← "entry" ¿
  ❴❵ → fns ¿
  ❴❵ → shapes ¿
  E "fns" ← fns ¿
  E "shapes" ← shapes ¿
  ❴❵ → byName ¿
  E "items" ← byName ¿
  ∅ → entry ¿
  0 → i ¿
  items ⟪ len ⟫ → n ¿
  i n ≺ ⟲ ↵
    items i ⌈ ⌉ → it ¿
    it "kind" ⌈ ⌉ "particle" ≡ ⤴ ↵
      it "rep" ⌈ ⌉ ⟪ ck_canon ⟫ → rp ¿
      EM_PARTICLES it "name" ⌈ ⌉ ← rp ¿
    ⌫ ¿
    i 1 ⊞ → i ¿
  ⌫ ¿
  0 → i ¿
  0 → nffi ¿
  【】 → glue ¿
  【】 → decls ¿
  i n ≺ ⟲ ↵
    items i ⌈ ⌉ → it ¿
    it "kind" ⌈ ⌉ "particle" ≡ ⤴ ↵ i 1 ⊞ → i ¿ ⊕ ¿ ⌫ ¿
    it "sig" ⌈ ⌉ it "rev" ⌈ ⌉ it "name" ⌈ ⌉ ⟪ ck_fn_info ⟫ → f ¿
    it "name" ⌈ ⌉ → nm ¿
    【"@\"trith." nm "\""】 ⟪ em_cat ⟫ → fsym ¿
    f "sym" ← fsym ¿
    byName nm ← it ¿
    it "kind" ⌈ ⌉ "ffi" ≡ ⤴ ↵
      E it f nffi ⟪ em_ffi ⟫ → g ¿
      E ⟪ em_failed ⟫ ⤴ ↵ ⊗ ¿ ⌫ ¿
      g "sym" ⌈ ⌉ → gsym ¿
      f "sym" ← gsym ¿
      f "ffi" ← ⊤ ¿
      glue g "c" ⌈ ⌉ ⟪ .append ⟫ ¿
      decls g "decl" ⌈ ⌉ ⟪ .append ⟫ ¿
      nffi 1 ⊞ → nffi ¿
    ⌫ ¿
    fns nm ← f ¿
    it "sig" ⌈ ⌉ ⟪ ck_shape ⟫ → key ¿
    key shapes ∈ ¬ ⤴ ↵ shapes key ← 【】 ¿ ⌫ ¿
    shapes key ⌈ ⌉ nm ⟪ .append ⟫ ¿
    nm "ᛟ" ≡ ⤴ ↵ f → entry ¿ ⌫ ¿
    i 1 ⊞ → i ¿
  ⌫ ¿
  E ⟪ em_failed ⟫ ¬ entry ∅ ≡ ∧ ⤴ ↵ E ∅ "a program needs an entry point ᛟ ⟨⊸⟩" ⟪ em_err ⟫ ¿ ⌫ ¿
  ⍝ every ⇋ function gets a generated inverse ⇜name
  0 → i ¿
  i n ≺ E ⟪ em_failed ⟫ ¬ ∧ ⟲ ↵
    items i ⌈ ⌉ → it ¿
    it "kind" ⌈ ⌉ "fn" ≡ it "rev" ⌈ ⌉ ∧ ⤴ ↵
      it "name" ⌈ ⌉ → nm ¿
      【"⇜" nm】 ⟪ em_cat ⟫ → inm ¿
      it "sig" ⌈ ⌉ ⊤ inm ⟪ ck_fn_info ⟫ → f ¿
      【"@\"trith." inm "\""】 ⟪ em_cat ⟫ → fsym ¿
      f "sym" ← fsym ¿
      fns inm ← f ¿
    ⌫ ¿
    i 1 ⊞ → i ¿
  ⌫ ¿
  0 → i ¿
  i n ≺ E ⟪ em_failed ⟫ ¬ ∧ ⟲ ↵
    items i ⌈ ⌉ → it ¿
    it "kind" ⌈ ⌉ "fn" ≡ ⤴ ↵
      E it fns it "name" ⌈ ⌉ ⌈ ⌉ ⟪ em_function ⟫ ¿
      it "rev" ⌈ ⌉ E ⟪ em_failed ⟫ ¬ ∧ ⤴ ↵
        it "name" ⌈ ⌉ → nm ¿
        【"⇜" nm】 ⟪ em_cat ⟫ → inm ¿
        E it "ops" ⌈ ⌉ ⟪ em_invert ⟫ → iops ¿
        E ⟪ em_failed ⟫ ¬ ⤴ ↵
          it "tok" ⌈ ⌉ → itok ¿
          ❴"kind": "fn", "name": inm, "tok": itok, "ops": iops❵ → inv ¿
          E inv fns inm ⌈ ⌉ ⟪ em_function ⟫ ¿
        ⌫ ¿
      ⌫ ¿
    ⌫ ¿
    i 1 ⊞ → i ¿
  ⌫ ¿
  E "err" ⌈ ⌉ → err ¿
  err ∅ ≢ ⤴ ↵ ❴"ir": "", "err": err, "glue": ""❵ ⇄ ¿ ⌫ ¿
  【】 → out ¿
  out "; generated by trithc (s1)" ⟪ .append ⟫ ¿
  out "%trith.arr = type { ptr, i64, i64 }" ⟪ .append ⟫ ¿
  out "declare ptr @trith_arr_new(i64, i64)" ⟪ .append ⟫ ¿
  out "declare ptr @trith_arr_push(ptr, i64)" ⟪ .append ⟫ ¿
  out "declare void @trith_arr_free(ptr, i64)" ⟪ .append ⟫ ¿
  out "declare void @trith_print_str_ref(ptr)" ⟪ .append ⟫ ¿
  out decls ⟪ em_concat_into ⟫ ¿
  out "declare ptr @trith_str_new(ptr, i64)" ⟪ .append ⟫ ¿
  out "declare void @trith_str_free(ptr)" ⟪ .append ⟫ ¿
  out "declare void @trith_print_str(ptr)" ⟪ .append ⟫ ¿
  out "declare void @trith_print_i64(i64)" ⟪ .append ⟫ ¿
  out "declare void @trith_print_f64(double)" ⟪ .append ⟫ ¿
  out "declare void @trith_loop_failed()" ⟪ .append ⟫ ¿
  out "declare void @trith_reversal_failed()" ⟪ .append ⟫ ¿
  out "declare void @trith_collapse_empty()" ⟪ .append ⟫ ¿
  out "declare void @trith_entry_failed()" ⟪ .append ⟫ ¿
  out "declare void @llvm.assume(i1)" ⟪ .append ⟫ ¿
  out "declare void @llvm.trap()" ⟪ .append ⟫ ¿
  out E "globals" ⌈ ⌉ ⟪ em_concat_into ⟫ ¿
  out E "lines" ⌈ ⌉ ⟪ em_concat_into ⟫ ¿
  out "" ⟪ .append ⟫ ¿
  entry "sym" ⌈ ⌉ → es ¿
  out "declare void @trith_set_args(i32, ptr)" ⟪ .append ⟫ ¿
  out "define i32 @main(i32 %argc, ptr %argv) {" ⟪ .append ⟫ ¿
  out "entry:" ⟪ .append ⟫ ¿
  out "  call void @trith_set_args(i32 %argc, ptr %argv)" ⟪ .append ⟫ ¿
  entry "outs" ⌈ ⌉ ⟪ len ⟫ 0 ≡ ⤴ ↵
    out 【"  call void " es "()"】 ⟪ em_cat ⟫ ⟪ .append ⟫ ¿
    out "  ret i32 0" ⟪ .append ⟫ ¿
  ⌫ ⤵ ↵
    out 【"  %r = call i1 " es "()"】 ⟪ em_cat ⟫ ⟪ .append ⟫ ¿
    out "  br i1 %r, label %ok, label %bad" ⟪ .append ⟫ ¿
    out "ok:" ⟪ .append ⟫ ¿
    out "  ret i32 0" ⟪ .append ⟫ ¿
    out "bad:" ⟪ .append ⟫ ¿
    out "  call void @trith_entry_failed()" ⟪ .append ⟫ ¿
    out "  ret i32 27" ⟪ .append ⟫ ¿
  ⌫ ¿
  out "}" ⟪ .append ⟫ ¿
  ⍝ alias classes: array headers (len, data) never alias array elements
  out "!0 = !{!\"trith tbaa\"}" ⟪ .append ⟫ ¿
  out "!1 = !{!\"trith.len\", !0, i64 0}" ⟪ .append ⟫ ¿
  out "!2 = !{!\"trith.data\", !0, i64 0}" ⟪ .append ⟫ ¿
  out "!3 = !{!\"trith.elem\", !0, i64 0}" ⟪ .append ⟫ ¿
  out "!4 = !{!1, !1, i64 0}" ⟪ .append ⟫ ¿
  out "!5 = !{!2, !2, i64 0}" ⟪ .append ⟫ ¿
  out "!6 = !{!3, !3, i64 0}" ⟪ .append ⟫ ¿
  out "\n" ⟪ join ⟫ → ir ¿
  "" → gluec ¿
  glue ⟪ len ⟫ 0 ≻ ⤴ ↵
    【】 → gl ¿
    gl "/* FFI glue generated by trithc: the C compiler sees the real prototypes */" ⟪ .append ⟫ ¿
    gl "#include <fcntl.h>" ⟪ .append ⟫ ¿
    gl "#include <math.h>" ⟪ .append ⟫ ¿
    gl "#include <stdint.h>" ⟪ .append ⟫ ¿
    gl "#include <stdio.h>" ⟪ .append ⟫ ¿
    gl "#include <stdlib.h>" ⟪ .append ⟫ ¿
    gl "#include <string.h>" ⟪ .append ⟫ ¿
    gl "#include <time.h>" ⟪ .append ⟫ ¿
    gl "#include <unistd.h>" ⟪ .append ⟫ ¿
    0 → q ¿
    includes ⟪ len ⟫ → nq ¿
    q nq ≺ ⟲ ↵
      includes q ⌈ ⌉ → inc ¿
      gl 【"#include \"" inc "\""】 ⟪ em_cat ⟫ ⟪ .append ⟫ ¿
      q 1 ⊞ → q ¿
    ⌫ ¿
    gl "typedef struct { char *ptr; int64_t len; int64_t cap; } TrithStr;" ⟪ .append ⟫ ¿
    gl "const char *trith_str_cstr(TrithStr *s);" ⟪ .append ⟫ ¿
    gl "TrithStr *trith_str_from_cstr(const char *c);" ⟪ .append ⟫ ¿
    gl "void trith_str_free(TrithStr *s);" ⟪ .append ⟫ ¿
    gl "int64_t trith_argc(void);" ⟪ .append ⟫ ¿
    gl "const char *trith_arg(int64_t i);" ⟪ .append ⟫ ¿
    gl "const char *trith_read_file(const char *path);" ⟪ .append ⟫ ¿
    gl "int64_t trith_write_file(const char *path, const char *data);" ⟪ .append ⟫ ¿
    gl glue ⟪ em_concat_into ⟫ ¿
    gl "\n" ⟪ join ⟫ → gluec ¿
  ⌫ ¿
  ❴"ir": ir, "err": ∅, "glue": gluec❵ ⇄ ¿
↦ items ↦ path ↦ debug ↦ includes ↦ trith_emit ¿
