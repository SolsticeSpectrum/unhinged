"lexer.uh" ⟪ import ⟫ ¿
"parser.uh" ⟪ import ⟫ ¿
"check.uh" ⟪ import ⟫ ¿
"emit.uh" ⟪ import ⟫ ¿
"eval.uh" ⟪ import ⟫ ¿

⍝ trithc: the Trith compiler (stage s1, written in UNHINGED)
⍝ Milestone 1: lexer and parser. Code generation arrives in milestone 3.

ƒ
  path ⟪ len ⟫ → n ¿
  path n 4 ⊟ 4 ⟪ substr ⟫ ".trh" ≡ path n 2 ⊟ 2 ⟪ substr ⟫ ".ŧ" ≡ ∨ ⇄ ¿
↦ path ↦ trith_ext_ok ¿

ƒ
  input ⟪ trith_ext_ok ⟫ ¬ ⤴ ↵
    input ": error: Trith sources end in .trh (or .ŧ)" ⊞⊞ ⊢ ¿
    1 ⇄ ¿
  ⌫ ¿
  input ⟪ read_file ⟫ → src ¿
  src "" ≡ ⤴ ↵
    input ": error: cannot read file (or file is empty)" ⊞⊞ ⊢ ¿
    1 ⇄ ¿
  ⌫ ¿
  src input mode "plough" ≡ ⟪ trith_lex_lines ⟫ → lx ¿
  lx "err" ⌈ ⌉ ∅ ≢ ⤴ ↵
    lx "err" ⌈ ⌉ ⊢ ¿
    1 ⇄ ¿
  ⌫ ¿
  lx "tokens" ⌈ ⌉ → toks ¿
  mode "plough" ≡ ⤴ ↵ lx "disk" ⟪ lx_plough ⟫ ⊢ ¿ 0 ⇄ ¿ ⌫ ¿
  mode "unplough" ≡ ⤴ ↵ lx "logical" ⟪ lx_plough ⟫ ⊢ ¿ 0 ⇄ ¿ ⌫ ¿
  mode "tokens" ≡ ⤴ ↵
    0 → i ¿
    toks ⟪ len ⟫ → n ¿
    i n ≺ ⟲ ↵
      toks i ⌈ ⌉ ⟪ lx_dump_token ⟫ ⊢ ¿
      i 1 ⊞ → i ¿
    ⌫ ¿
    0 ⇄ ¿
  ⌫ ¿
  toks input ⟪ trith_parse ⟫ → ps ¿
  ps "err" ⌈ ⌉ ∅ ≢ ⤴ ↵
    ps "err" ⌈ ⌉ ⊢ ¿
    1 ⇄ ¿
  ⌫ ¿
  mode "ast" ≡ ⤴ ↵
    ps "items" ⌈ ⌉ ⟪ ps_dump ⟫ → lines ¿
    0 → i ¿
    lines ⟪ len ⟫ → n ¿
    i n ≺ ⟲ ↵
      lines i ⌈ ⌉ ⊢ ¿
      i 1 ⊞ → i ¿
    ⌫ ¿
    0 ⇄ ¿
  ⌫ ¿
  ps "items" ⌈ ⌉ input mode "check" ≡ ⟪ trith_check ⟫ → ck ¿
  mode "check" ≡ ⤴ ↵
    ck "lines" ⌈ ⌉ → lines ¿
    0 → i ¿
    lines ⟪ len ⟫ → n ¿
    i n ≺ ⟲ ↵
      lines i ⌈ ⌉ ⊢ ¿
      i 1 ⊞ → i ¿
    ⌫ ¿
  ⌫ ¿
  ck "err" ⌈ ⌉ ∅ ≢ ⤴ ↵
    ck "err" ⌈ ⌉ ⊢ ¿
    1 ⇄ ¿
  ⌫ ¿
  mode "check" ≡ ⤴ ↵ "ok" ⊢ ¿ 0 ⇄ ¿ ⌫ ¿
  ps "items" ⌈ ⌉ input debug includes ⟪ trith_emit ⟫ → em ¿
  em "err" ⌈ ⌉ ∅ ≢ ⤴ ↵
    em "err" ⌈ ⌉ ⊢ ¿
    1 ⇄ ¿
  ⌫ ¿
  mode "llvm" ≡ ⤴ ↵ em "ir" ⌈ ⌉ ⊢ ¿ 0 ⇄ ¿ ⌫ ¿
  output "" ≡ ⤴ ↵ input ⟪ trith_default_output ⟫ → output ¿ ⌫ ¿
  output ".ll" ⊞⊞ → llpath ¿
  llpath em "ir" ⌈ ⌉ ⟪ write_file ⟫ → ok ¿
  ok 1 ≢ ⤴ ↵
    llpath ": error: cannot write" ⊞⊞ ⊢ ¿
    1 ⇄ ¿
  ⌫ ¿
  "-O2" → opt ¿
  debug ⤴ ↵ "-O0 -g" → opt ¿ ⌫ ¿
  ⍝ C sources (runtime, FFI glue, --link files) become LLVM IR and are linked
  ⍝ into one module before optimising, so calls into them can inline
  【"trith/runtime/trith_rt.c"】 → csrcs ¿
  em "glue" ⌈ ⌉ "" ≢ ⤴ ↵
    output ".ffi.c" ⊞⊞ → gpath ¿
    gpath em "glue" ⌈ ⌉ ⟪ write_file ⟫ → _ ¿
    csrcs gpath ⟪ .append ⟫ ¿
  ⌫ ¿
  ⍝ a --link of -lNAME is a library for the final link, not a C file
  "" → libs ¿
  0 → li ¿
  links ⟪ len ⟫ → nl ¿
  li nl ≺ ⟲ ↵
    links li ⌈ ⌉ → lk ¿
    lk 0 2 ⟪ substr ⟫ "-l" ≡ ⤴ ↵ libs " " ⊞⊞ lk ⊞⊞ → libs ¿ ⌫ ⤵ ↵ csrcs lk ⟪ .append ⟫ ¿ ⌫ ¿
    li 1 ⊞ → li ¿
  ⌫ ¿
  【llpath】 → lls ¿
  0 → ci ¿
  csrcs ⟪ len ⟫ → nc ¿
  ci nc ≺ ⟲ ↵
    csrcs ci ⌈ ⌉ → src ¿
    ci ⍕ → cis ¿
    【output ".c" cis ".ll"】 "" ⟪ join ⟫ → cll ¿
    【"clang -S -emit-llvm " opt " -w -I . -o " cll " " src " 2>&1"】 "" ⟪ join ⟫ → ccmd ¿
    ccmd ⟪ syscall ⟫ → cout ¿
    cout "" ≢ ⤴ ↵
      cout ⊢ ¿
      1 ⇄ ¿
    ⌫ ¿
    lls cll ⟪ .append ⟫ ¿
    ci 1 ⊞ → ci ¿
  ⌫ ¿
  output ".bc" ⊞⊞ → bc ¿
  lls " " ⟪ join ⟫ → llList ¿
  【"llvm-link -o " bc " " llList " 2>&1"】 "" ⟪ join ⟫ → lcmd ¿
  lcmd ⟪ syscall ⟫ → lout ¿
  lout "" ≢ ⤴ ↵
    lout ⊢ ¿
    1 ⇄ ¿
  ⌫ ¿
  【"clang " opt " -w -o " output " " bc libs " -lm 2>&1"】 "" ⟪ join ⟫ → cmd ¿
  cmd ⟪ syscall ⟫ → out ¿
  out "" ≢ ⤴ ↵
    out ⊢ ¿
    1 ⇄ ¿
  ⌫ ¿
  0 ⇄ ¿
↦ input ↦ output ↦ mode ↦ debug ↦ includes ↦ links ↦ trithc_main ¿

⍝ main.trh → main, main.ŧ → main
ƒ
  path ⟪ len ⟫ → n ¿
  path n 4 ⊟ 4 ⟪ substr ⟫ ".trh" ≡ ⤴ ↵ path 0 n 4 ⊟ ⟪ substr ⟫ ⇄ ¿ ⌫ ¿
  path 0 n 2 ⊟ ⟪ substr ⟫ ⇄ ¿
↦ path ↦ trith_default_output ¿

⟪ args ⟫ → argv ¿
argv ⟪ len ⟫ → argc ¿
"" → input ¿
"" → output ¿
"compile" → mode ¿
⊥ → debug ¿
【】 → includes ¿
【】 → links ¿
1 → ai ¿
⊥ → bad ¿
ai argc ≺ ⟲ ↵
  argv ai ⌈ ⌉ → a ¿
  a "--tokens" ≡ ⤴ ↵ "tokens" → mode ¿
  ⌫ ⤵ a "--ast" ≡ ⤴ ↵ "ast" → mode ¿
  ⌫ ⤵ a "--check" ≡ ⤴ ↵ "check" → mode ¿
  ⌫ ⤵ a "--emit-llvm" ≡ ⤴ ↵ "llvm" → mode ¿
  ⌫ ⤵ a "--debug" ≡ ⤴ ↵ ⊤ → debug ¿
  ⌫ ⤵ a "--include" ≡ ⤴ ↵
    ai 1 ⊞ → ai ¿
    ai argc ≺ ⤴ ↵ includes argv ai ⌈ ⌉ ⟪ .append ⟫ ¿ ⌫ ⤵ ↵ ⊤ → bad ¿ ⌫ ¿
  ⌫ ⤵ a "--link" ≡ ⤴ ↵
    ai 1 ⊞ → ai ¿
    ai argc ≺ ⤴ ↵ links argv ai ⌈ ⌉ ⟪ .append ⟫ ¿ ⌫ ⤵ ↵ ⊤ → bad ¿ ⌫ ¿
  ⌫ ⤵ a "--plough" ≡ ⤴ ↵ "plough" → mode ¿
  ⌫ ⤵ a "--unplough" ≡ ⤴ ↵ "unplough" → mode ¿
  ⌫ ⤵ a "-o" ≡ ⤴ ↵
    ai 1 ⊞ → ai ¿
    ai argc ≺ ⤴ ↵ argv ai ⌈ ⌉ → output ¿ ⌫ ⤵ ↵ ⊤ → bad ¿ ⌫ ¿
  ⌫ ⤵ input "" ≡ ⤴ ↵ a → input ¿
  ⌫ ⤵ ↵ ⊤ → bad ¿
  ⌫ ¿
  ai 1 ⊞ → ai ¿
⌫ ¿
input "" ≡ bad ∨ ⤴ ↵
  "usage: trithc <main.trh> [-o <output>] [--debug] [--tokens | --ast | --check | --emit-llvm | --plough | --unplough]" ⊢ ¿
  "  (default)   compile to a native binary with clang -O2 (run from the repo root)" ⊢ ¿
  "  --debug     compile with -O0; prayers (⍤) trap instead of informing the optimiser" ⊢ ¿
  "  --include h make C header h visible to FFI bindings (⎔)" ⊢ ¿
  "  --link f.c  compile and link C file f.c (for FFI bindings); --link -lNAME links a library" ⊢ ¿
  "  --tokens    print the token stream (after the Boustrophedon Rule)" ⊢ ¿
  "  --ast       print the parsed and tangled item tree" ⊢ ¿
  "  --check     type-check and print the virtual stack after every operation" ⊢ ¿
  "  --emit-llvm print the generated LLVM IR" ⊢ ¿
  "  --plough    rewrite a file written in logical order (every line left to right)" ⊢ ¿
  "              into on-disk order, padding with breaths ⸱ to satisfy the Balance Law" ⊢ ¿
  "  --unplough  rewrite an on-disk file into logical order for reading" ⊢ ¿
⌫ ⤵ ↵
  input output mode debug includes links ⟪ trithc_main ⟫ → _ ¿
⌫ ¿
