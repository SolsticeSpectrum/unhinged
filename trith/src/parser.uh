ƒ
  n "kind" ⌈ ⌉ → k ¿
  n "tok" ⌈ ⌉ → t ¿
  t ⟪ ps_marks_str ⟫ → ms ¿
  ind "  " ⊞⊞ → ind2 ¿
  k "lit" ≡ ⤴ ↵
    t "text" ⌈ ⌉ → shown ¿
    t "kind" ⌈ ⌉ "string" ≡ ⤴ ↵ shown ⟪ lx_quote ⟫ → shown ¿ ⌫ ¿
    ind "lit " t "kind" ⌈ ⌉ " " shown ⊞⊞ ⊞⊞ ⊞⊞ ⊞⊞ → line ¿
    t "value" ⌈ ⌉ ∅ ≢ ⤴ ↵ line " = " t "value" ⌈ ⌉ ⊞⊞ ⊞⊞ → line ¿ ⌫ ¿
    out line ms ⊞⊞ ⟪ .append ⟫ ¿
    ∅ ⇄ ¿
  ⌫ ¿
  k "call" ≡ k "anti-call" ≡ ∨ k "inverse-call" ≡ ∨ ⤴ ↵
    t ⟪ ps_fname ⟫ → nm ¿
    out ind k " " nm ms ⊞⊞ ⊞⊞ ⊞⊞ ⊞⊞ ⟪ .append ⟫ ¿
    ∅ ⇄ ¿
  ⌫ ¿
  k "op" ≡ ⤴ ↵
    ind "op " t "text" ⌈ ⌉ ⊞⊞ ⊞⊞ → line ¿
    t "idx" ⌈ ⌉ ∅ ≢ ⤴ ↵ line " idx=" t "idx" ⌈ ⌉ ⍕ ⊞⊞ ⊞⊞ → line ¿ ⌫ ¿
    out line ms ⊞⊞ ⟪ .append ⟫ ¿
    ∅ ⇄ ¿
  ⌫ ¿
  k "shape-call" ≡ ⤴ ↵
    n "sig" ⌈ ⌉ ⟪ ps_sig_str ⟫ → ss ¿
    out ind "shape-call " ss ⊞⊞ ⊞⊞ ⟪ .append ⟫ ¿
    ∅ ⇄ ¿
  ⌫ ¿
  k "quote" ≡ ⤴ ↵
    out ind "quote" ⊞⊞ ⟪ .append ⟫ ¿
    out n "block" ⌈ ⌉ "ops" ⌈ ⌉ ind2 ⟪ ps_dump_ops ⟫ ¿
    ∅ ⇄ ¿
  ⌫ ¿
  k "array" ≡ ⤴ ↵
    out ind "array" ⊞⊞ ⟪ .append ⟫ ¿
    out n "ops" ⌈ ⌉ ind2 ⟪ ps_dump_ops ⟫ ¿
    ∅ ⇄ ¿
  ⌫ ¿
  k "select" ≡ k "rselect" ≡ ∨ ⤴ ↵
    out ind k ms ⊞⊞ ⊞⊞ ⟪ .append ⟫ ¿
    n "faces" ⌈ ⌉ → fs ¿
    0 → i ¿
    i 3 ≺ ⟲ ↵
      fs i ⌈ ⌉ → f ¿
      f "kind" ⌈ ⌉ "same" ≡ ⤴ ↵ out ind2 "face ⁼" ⊞⊞ ⟪ .append ⟫ ¿
      ⌫ ⤵ f "kind" ⌈ ⌉ "identity" ≡ ⤴ ↵ out ind2 "face ∅" ⊞⊞ ⟪ .append ⟫ ¿
      ⌫ ⤵ ↵
        out ind2 "face" ⊞⊞ ⟪ .append ⟫ ¿
        ind2 "  " ⊞⊞ → ind3 ¿
        out f "ops" ⌈ ⌉ ind3 ⟪ ps_dump_ops ⟫ ¿
      ⌫ ¿
      i 1 ⊞ → i ¿
    ⌫ ¿
    k "rselect" ≡ ⤴ ↵
      out ind2 "assert" ⊞⊞ ⟪ .append ⟫ ¿
      ind2 "  " ⊞⊞ → ind3 ¿
      out n "assert" ⌈ ⌉ "ops" ⌈ ⌉ ind3 ⟪ ps_dump_ops ⟫ ¿
    ⌫ ¿
    ∅ ⇄ ¿
  ⌫ ¿
  k "handle" ≡ ⤴ ↵
    out ind "handle" ms ⊞⊞ ⊞⊞ ⟪ .append ⟫ ¿
    ind2 "  " ⊞⊞ → ind3 ¿
    out ind2 "ok" ⊞⊞ ⟪ .append ⟫ ¿
    out n "ok" ⌈ ⌉ "ops" ⌈ ⌉ ind3 ⟪ ps_dump_ops ⟫ ¿
    out ind2 "fail" ⊞⊞ ⟪ .append ⟫ ¿
    out n "fail" ⌈ ⌉ "ops" ⌈ ⌉ ind3 ⟪ ps_dump_ops ⟫ ¿
    ∅ ⇄ ¿
  ⌫ ¿
  ⍝ loop, postselect, prayer
  ind k ⊞⊞ → line ¿
  t "idx" ⌈ ⌉ ∅ ≢ ⤴ ↵ line " n=" t "idx" ⌈ ⌉ ⍕ ⊞⊞ ⊞⊞ → line ¿ ⌫ ¿
  out line ms ⊞⊞ ⟪ .append ⟫ ¿
  out n "block" ⌈ ⌉ "ops" ⌈ ⌉ ind2 ⟪ ps_dump_ops ⟫ ¿
  ∅ ⇄ ¿
↦ out ↦ n ↦ ind ↦ ps_dump_op ¿

ƒ
  【】 → out ¿
  0 → i ¿
  items ⟪ len ⟫ → n ¿
  i n ≺ ⟲ ↵
    items i ⌈ ⌉ → it ¿
    it "kind" ⌈ ⌉ → k ¿
    k "fn" ≡ ⤴ ↵
      it "sig" ⌈ ⌉ ⟪ ps_sig_str ⟫ → ss ¿
      "fn " it "name" ⌈ ⌉ " " ss ⊞⊞ ⊞⊞ ⊞⊞ → line ¿
      it "rev" ⌈ ⌉ ⤴ ↵ line " reversible" ⊞⊞ → line ¿ ⌫ ¿
      it "frags" ⌈ ⌉ → fr ¿
      fr ⟪ len ⟫ 1 ≻ fr 0 ⌈ ⌉ "○" ≢ ∨ ⤴ ↵ line " fragments=" fr "," ⟪ join ⟫ ⊞⊞ ⊞⊞ → line ¿ ⌫ ¿
      out line ⟪ .append ⟫ ¿
      out it "ops" ⌈ ⌉ "  " ⟪ ps_dump_ops ⟫ ¿
    ⌫ ⤵ k "particle" ≡ ⤴ ↵
      it "rep" ⌈ ⌉ ⟪ ps_type_str ⟫ → rs ¿
      out "particle " it "name" ⌈ ⌉ " " rs ⊞⊞ ⊞⊞ ⊞⊞ ⟪ .append ⟫ ¿
    ⌫ ⤵ ↵
      it "sig" ⌈ ⌉ ⟪ ps_sig_str ⟫ → ss ¿
      it "cname" ⌈ ⌉ ⟪ lx_quote ⟫ → cn ¿
      out "ffi " it "name" ⌈ ⌉ " " cn " " ss ⊞⊞ ⊞⊞ ⊞⊞ ⊞⊞ ⊞⊞ ⟪ .append ⟫ ¿
    ⌫ ¿
    i 1 ⊞ → i ¿
  ⌫ ¿
  out ⇄ ¿
↦ items ↦ ps_dump ¿
